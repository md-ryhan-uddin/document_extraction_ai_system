# ==========================================
# Django Settings
# ==========================================
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True                          # Set to False in production
ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================================
# API Configuration (Required)
# ==========================================
OPENAI_API_KEY=your-openai-api-key-here
MODEL_NAME=gpt-4o-mini

# ==========================================
# Database Configuration
# ==========================================
# For Docker (automatically configured by docker-compose.yml)
POSTGRES_DB=docai_db
POSTGRES_USER=docai_user
POSTGRES_PASSWORD=docai_password

# For Production/Render (use DATABASE_URL)
# DATABASE_URL=postgresql://user:password@host:5432/database

# Redis Configuration
# REDIS_URL=redis://redis:6379/0

# ==========================================
# Document Processing Settings
# ==========================================
DEFAULT_DPI=200
HIGH_DPI=300
LOW_CONFIDENCE_THRESHOLD=0.6
MAX_FILE_SIZE=52428800  # 50MB in bytes

# ==========================================
# Rate Limiting & Security (Production)
# These limits protect against abuse and manage API costs
# ==========================================
UPLOAD_RATE_PER_HOUR=10            # Max uploads per hour per IP
UPLOAD_DAILY_LIMIT=50              # Max uploads per day per IP
MAX_CONCURRENT_PROCESSING=3         # Max simultaneous processing per IP
MAX_FILE_SIZE_MB=10                # Max file size in MB
PROCESSING_TIMEOUT=3600            # Processing timeout in seconds (1 hour)
THROTTLE_WAIT_TIME=60              # Wait time when throttled in seconds

# ==========================================
# Deployment Settings (for Render)
# ==========================================
# PORT=10000                        # Application port (Render default)
# PYTHON_VERSION=3.11.0             # Python version
